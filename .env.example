# ==============================
# AURORA Environment Configuration
# ==============================
# Copy this file to `.env` and add real credentials there. Never commit `.env`.

# Database Configuration
POSTGRES_USER=aurora
POSTGRES_PASSWORD=aurora
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aurora_db

# Automated tests create isolated databases derived from POSTGRES_DB.
# Never point tests at a database containing development or production data.

# Security & Cookie Configuration
AUTH_COOKIE_NAME=aurora_session
SESSION_EXPIRY_DAYS=7
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Optional Google OpenID Connect login (server-side only).
# Use this exact local callback in Google Cloud and open the frontend at localhost:3000.
GOOGLE_OAUTH_ENABLED=False
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_OAUTH_TRANSACTION_TTL_SECONDS=600

# Local document storage (Cloudflare R2 is a future deployment adapter)
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_ROOT=storage/uploads
DOCUMENT_MAX_SIZE_BYTES=10485760

# Canonical multi-format ingestion and bounded local PDF OCR.
# Install Tesseract 5 with English and Hindi trained data. Set the executable
# explicitly only when it is not discoverable through PATH.
PDF_MAX_PAGES=250
PDF_RENDER_DPI=300
PDF_MAX_RENDERED_PIXELS_PER_PAGE=40000000
PDF_MAX_TOTAL_RENDERED_PIXELS=900000000
OCR_MAX_PAGES=100
OCR_TIMEOUT_SECONDS_PER_PAGE=30
OCR_LANGUAGES=eng+hin
TESSERACT_EXECUTABLE=
NATIVE_TEXT_MIN_CHARACTERS=8
OCR_TEXT_MIN_CHARACTERS=12
EXTRACTION_MIN_PRINTABLE_RATIO=0.85
OCR_MIN_CONFIDENCE=0.25
EXTRACTION_MAX_CHARACTERS=5000000
INGESTION_MAX_UNITS=10000
TABULAR_MAX_ROWS=50000
TABULAR_MAX_COLUMNS=500
TABULAR_MAX_CELLS=250000
TABULAR_MAX_FIELD_CHARACTERS=100000
TABULAR_ROWS_PER_UNIT=50
OOXML_MAX_ARCHIVE_ENTRIES=10000
OOXML_MAX_UNCOMPRESSED_BYTES=104857600
DOCX_MAX_PARAGRAPHS=20000
PPTX_MAX_SLIDES=1000
XLSX_MAX_SHEETS=250

# RAG indexing and embeddings
# The API key is read only at runtime; leave it empty in source-controlled files.
GEMINI_API_KEY=
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
CHUNK_SIZE_CHARACTERS=1000
CHUNK_OVERLAP_CHARACTERS=150
RETRIEVAL_MAX_TOP_K=20
RETRIEVAL_CANDIDATE_MULTIPLIER=4

# Grounded answer generation (independent from the embedding model)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
LLM_MAX_OUTPUT_TOKENS=1024
RAG_CONTEXT_MAX_CHARACTERS=12000
RAG_MIN_SIMILARITY=0.30

# Persistent conversation context (recent context is not retrieval evidence)
CONVERSATION_HISTORY_MAX_MESSAGES=8
CONVERSATION_HISTORY_MAX_CHARACTERS=6000
STREAMING_MAX_RESPONSE_CHARACTERS=32768
